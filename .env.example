# ---------------------------------------------------------------
# Sourcing Eleven — environment variables
# Copy to .env.local for development. In production, set these in
# your hosting provider's environment settings. Never commit secrets.
# ---------------------------------------------------------------

# --- Site -------------------------------------------------------
# Public origin, no trailing slash. Used for canonicals, sitemap, OG, schema.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Set to "preview" on staging deployments to block indexing in robots.txt
NEXT_PUBLIC_SITE_ENV=production

# --- Admin authentication (required for /admin) -----------------
# Random string, at least 32 characters: `openssl rand -hex 32`
SESSION_SECRET=
# Single admin user (simple setup). Generate the hash with:
#   npm run admin:hash -- "a long passphrase"
# Escape each $ as \$ inside .env files.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD_HASH=
# Or several users with roles ("admin" can change settings and delete enquiries; "editor" manages content and enquiries):
# ADMIN_USERS=[{"email":"a@example.com","name":"Ayesha","role":"admin","passwordHash":"scrypt$..."},{"email":"b@example.com","name":"Bilal","role":"editor","passwordHash":"scrypt$..."}]

# --- Data storage -----------------------------------------------
# Without Supabase, data is stored in a JSON file + uploads folder under DATA_DIR
# (default ./.data). Suitable for development and single-server Node hosting.
# DATA_DIR=/var/lib/sourcing-eleven
# Supabase (recommended for production, required on serverless hosts):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional bucket overrides (defaults shown)
# SUPABASE_ATTACHMENTS_BUCKET=enquiry-attachments
# SUPABASE_MEDIA_BUCKET=media

# --- Email notifications (Resend) -------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "Sourcing Eleven <website@yourdomain.com>"
EMAIL_FROM=
# Where new enquiry/quote notifications go (comma-separated for several)
NOTIFICATION_EMAIL=

# --- Spam protection (optional CAPTCHA layer) -------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (loaded only after visitor consent) --------------
# Use GTM *or* GA4. If both are set, GTM is used.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# --- Search engine verification ---------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Optional public contact defaults (admin settings override) -
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_TWITTER_HANDLE=

# --- End-to-end tests only --------------------------------------
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=
# PLAYWRIGHT_CHROME_PATH=/usr/bin/google-chrome
